toplevel "TOP";

"TOP" or "G_STATIC" "G_DYN";

"G_STATIC" and "R1" "F1" "F2";

"G_DYN" and "G_DYN_P" "F4";
"G_DYN_P" pand "R2" "F3";

"F1" fail~exponential(3.333333333333e-06) repair~exponential(1.000000000000e-12);
"F2" fail~exponential(3.333333333333e-06) repair~exponential(1.000000000000e-12);
"F3" fail~exponential(3.333333333333e-06) repair~exponential(1.000000000000e-12);
"F4" fail~exponential(3.333333333333e-06) repair~exponential(1.000000000000e-12);
"R1" fail~exponential(3.333333333333e-06) repair~exponential(1.000000000000e-12);
"R2" fail~exponential(3.333333333333e-06) repair~exponential(1.000000000000e-12);
